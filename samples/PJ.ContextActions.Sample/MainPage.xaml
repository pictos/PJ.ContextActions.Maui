<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
	x:Class="PJ.ContextActions.Sample.MainPage"
	xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
	xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
	Title="ContextActions Samples">

	<VerticalStackLayout
		Padding="32"
		Spacing="16"
		VerticalOptions="Center">

		<Label
			FontAttributes="Bold"
			FontSize="22"
			HorizontalOptions="Center"
			Text="ContextActions Samples" />

		<Label
			HorizontalOptions="Center"
			HorizontalTextAlignment="Center"
			Text="Select a sample to explore."
			TextColor="Gray" />

		<Button
			Clicked="OnSimpleSampleClicked"
			HorizontalOptions="Fill"
			Text="Simple Sample" />

		<Button
			Clicked="OnTextColorIsEnabledClicked"
			HorizontalOptions="Fill"
			Text="TextColor &amp; IsEnabled" />

	</VerticalStackLayout>
</ContentPage>
